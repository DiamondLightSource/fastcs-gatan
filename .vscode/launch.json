{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Gatan: print config schema",
            "type": "debugpy",
            "request": "launch",
            "module": "fastcs_gatan",
            "justMyCode": false,
            "console": "integratedTerminal",
            "args": [
                "schema"
            ]
        },
        {
            "name": "Gatan: run",
            "type": "debugpy",
            "request": "launch",
            "module": "fastcs_gatan",
            "justMyCode": false,
            "console": "integratedTerminal",
            "args": [
                "run",
                "${workspaceFolder}/gatan.yaml"
            ]
        },
        {
            // Synthetic GatanSocket server from GatanDetectorClient (test target
            // only, not a dependency). --k3 mimics a real K3's quirks.
            "name": "Gatan: mock server (K3)",
            "type": "debugpy",
            "request": "launch",
            "module": "gatan_client.mock_server",
            "cwd": "/workspaces/GatanDetectorClient-0.1.0",
            "justMyCode": false,
            "console": "integratedTerminal",
            "args": [
                "--k3",
                "--port",
                "48890",
                "-v"
            ]
        },
        {
            "name": "Debug Unit Test",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "${file}",
            "purpose": [
                "debug-test"
            ],
            "console": "integratedTerminal",
        }
    ],
    "compounds": [
        {
            "name": "Gatan: mock server + run",
            "configurations": [
                "Gatan: mock server (K3)",
                "Gatan: run"
            ],
            "stopAll": true
        }
    ]
}
