    "version": "0.2.0",
    "configurations": [
        {
            "name": "Gatan: print config schema",
            "type": "debugpy",
            "request": "launch",
            "module": "fastcs_gatan",
            "justMyCode": false,
            "console": "integratedTerminal",
            "args": [
                "schema"
            ]
        },
        {
            "name": "Gatan: run",
            "type": "debugpy",
            "request": "launch",
            "module": "fastcs_gatan",
            "justMyCode": false,
            "console": "integratedTerminal",
            "args": [
                "run",
                "${workspaceFolder}/gatan.yaml"
            ]
        },
        {
            "name": "Debug Unit Test",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "${file}",
            "purpose": [
                "debug-test"
            ],
            "console": "integratedTerminal",
        }
    ]
}
